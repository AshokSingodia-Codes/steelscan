# =====================================================
# STEELSCAN BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# =====================================================

# App Environment (development | production | test)
APP_ENV=development

# Database Connection URL (SQLite locally, PostgreSQL in production)
DATABASE_URL=sqlite:///./steelscan.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Security (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_256bit_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Administrator Provisioning (Required if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetAStrongPasswordHere123!

# Allowed Frontend Origins (Comma-separated, no wildcard in production)
FRONTEND_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Rate Limiting & Account Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SCAN_RATE_LIMIT=20/minute

# Reverse Proxy Trust Settings (for Render, Cloudflare, etc.)
TRUST_PROXY_HEADERS=false
PROXY_HOPS=1
TRUST_CF_HEADER=false

# Vision AI Configuration & Quota Protection
VISION_AI_ENABLED=true
DAILY_VISION_CALL_CAP=500
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Upload Constraints
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096